# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit source code and configuration files (always LF)
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.sql text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.proto text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Shell scripts (must use LF to execute on Unix/Linux/WSL)
*.sh text eol=lf
gradlew text eol=lf

# Windows batch files (require CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# Binary files
*.jar binary
*.sqlite binary
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.key binary
*.pub binary